{
  "expo": {
    "name": "MedicalRecords",
    "slug": "MedicalRecords",
    "version": "1.0.0",
    "scheme": "medicalrecords",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.joelotfy.MedicalRecords",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes":[
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.177259700447-g95a03da1ruq9vc6397of0csp4rlufi6",
              "medicalrecords"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.joelotfy.MedicalRecords",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8fe041d8-28ad-4636-a852-704c0ddc04e1"
      }
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ],
      "expo-document-picker",
      "expo-file-system",
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      [
        "expo-share-intent",
        {
          "iosActivationRules":{
            "NSExtensionActivationSupportsImageWithMaxCount": 20,
            "NSExtensionActivationSupportsFileWithMaxCount": 20
          },
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters":[
            "image/*",
            "application/pdf",
            "*/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MedicalRecords needs access to photos you choose to upload.",
          "cameraPermission": "MedicalRecords needs camera access to capture medical documents."
        }
      ]
    ]
  }
}
